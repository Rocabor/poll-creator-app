# SQLite database (local development). Swap for a PostgreSQL URL to deploy,
# e.g. postgresql://user:pass@host:5432/tiebreak?sslmode=require
DATABASE_URL="file:./dev.db"

# Public origin for share links, share cards (OG images) and the guest-flow
# session allowlist. Set to your deployed origin (e.g. https://tiebreak.app).
APP_URL="http://localhost:3000"