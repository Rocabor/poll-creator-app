# PostgreSQL (Supabase / Vercel Postgres / Neon).
# Session-pooler host (aws-0-<region>.pooler.supabase.com), port 5432 for Prisma.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public origin for share links, OG images and guest-flow cookie allowlist.
# Set to your deployed origin (e.g. https://tiebreak.vercel.app) when deploying.
APP_URL="http://localhost:3000"